# ── Скопируй этот файл в: /home/ubuntu/qamachine-saas/backend/.env ──────────

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=СГЕНЕРИРУЙ_СЛУЧАЙНЫЙ_КЛЮЧ_32_СИМВОЛА

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI mode
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# ── CORS (твой Vercel домен) ──────────────────────────────────────────────────
CORS_ORIGINS=["https://qamachine.vercel.app","https://yourdomain.com"]

# ── Frontend URL (для Stripe редиректов) ──────────────────────────────────────
FRONTEND_URL=https://qamachine.vercel.app

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── QAmachine engine (пути на VPS) ────────────────────────────────────────────
QAMACHINE_DIR=/home/ubuntu/QAmachine
QAMACHINE_PYTHON=/home/ubuntu/QAmachine/.venv/bin/python
QAMACHINE_RUNNER=/home/ubuntu/QAmachine/run_session.py

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=["danik441414@gmail.com"]
