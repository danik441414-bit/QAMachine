# ── App ─────────────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string-min-32-chars

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./qamachine.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/qamachine

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Anthropic (for the QAmachine engine) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── QAmachine engine paths ───────────────────────────────────────────────────
QAMACHINE_DIR=C:\path\to\QAmachine
QAMACHINE_PYTHON=C:\path\to\QAmachine\.venv\Scripts\python.exe
QAMACHINE_RUNNER=C:\path\to\QAmachine\run_session.py

# ── Email (Resend.com — https://resend.com) ───────────────────────────────────
RESEND_API_KEY=re_...
SMTP_FROM=noreply@qamachine.site
EMAIL_VERIFICATION_REQUIRED=true

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# ── NOWPayments (crypto) ──────────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=ZAF22W9-...
NOWPAYMENTS_IPN_SECRET=pIWWQK44...

# ── Dodo Payments (card) ──────────────────────────────────────────────────────
DODO_API_KEY=Tp_...
DODO_WEBHOOK_SECRET=whsec_...
DODO_PRODUCT_PRO=pdt_0NdvNDT96ai8qZZelTEGL
DODO_PRODUCT_TEAM=pdt_0NdvNJpwLeAjBz6xgSLPy
